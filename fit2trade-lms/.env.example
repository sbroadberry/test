# Fit2Trade Learn - environment configuration
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
DATA_DIR=./data
PUBLIC_URL=http://localhost:4000

# --- Microsoft Teams (Microsoft Graph, client-credentials flow) ---
# Requires an Entra ID app registration with OnlineMeetings.ReadWrite.All (application)
# and an application access policy granted to the organiser account.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_ORGANISER_USER_ID=
# Override for tests / sovereign clouds (defaults shown)
MS_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
MS_LOGIN_BASE_URL=https://login.microsoftonline.com

# --- Cisco Webex (Meetings REST API) ---
# A bot/integration or personal access token with meeting:schedules_write scope.
WEBEX_ACCESS_TOKEN=
WEBEX_BASE_URL=https://webexapis.com/v1

# When no provider credentials are configured the LMS uses the built-in
# "simulated" provider so live sessions still work in demo/test environments.
LIVE_PROVIDER_SIMULATE=true

# --- Single sign-on (OpenID Connect) ---
# Google: create an OAuth client (Web application) in Google Cloud Console and add
#   <PUBLIC_URL>/api/auth/sso/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft: register an app in Microsoft Entra ID (Web platform) with redirect URI
#   <PUBLIC_URL>/api/auth/sso/microsoft/callback; MS_SSO_TENANT can be "common", "organizations" or a tenant ID.
MS_SSO_CLIENT_ID=
MS_SSO_CLIENT_SECRET=
MS_SSO_TENANT=common
# Overrides for tests / sovereign clouds
# GOOGLE_AUTH_URL=, GOOGLE_TOKEN_URL=, GOOGLE_USERINFO_URL=, MS_SSO_AUTHORITY=, MS_SSO_USERINFO_URL=
