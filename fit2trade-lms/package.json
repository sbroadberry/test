{
  "name": "fit2trade-lms",
  "version": "1.0.0",
  "description": "Fit2Trade Learn - a modern learning management system (LearnUpon-style) branded for Fit2Trade.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c green,blue \"node --watch server/index.js\" \"vite\"",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "seed": "node server/seed.js",
    "test": "node --test \"tests/unit/**/*.test.js\" \"tests/api/**/*.test.js\" \"tests/integrations/**/*.test.js\"",
    "test:e2e": "node --test \"tests/e2e/**/*.test.js\"",
    "test:all": "npm run test && npm run build && npm run test:e2e",
    "scorm:packages": "node tests/fixtures/build-scorm-packages.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.0.0",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "nodemailer": "^7.0.13",
    "pdfkit": "^0.17.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "playwright": "^1.64.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
